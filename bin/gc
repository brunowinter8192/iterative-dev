#!/usr/bin/env bash

# INFRASTRUCTURE

set -e

# ORCHESTRATOR

main() {
  require_message "$@"
  commit_changes "$@"
}

# FUNCTIONS

require_message() {
  if [ $# -lt 1 ]; then
    echo "Usage: gc \"<msg>\" [files...]" >&2
    exit 1
  fi
}

commit_changes() {
  local msg="$1"
  shift
  if [ $# -eq 0 ]; then
    git commit -am "$msg"
  else
    git add "$@" && git commit -m "$msg"
  fi
}

main "$@"

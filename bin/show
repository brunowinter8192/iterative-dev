#!/usr/bin/env bash

set -e

SHOW_COPY_DIR="${TMPDIR:-/tmp}/show-copies"

if [ $# -lt 1 ]; then
  echo "Usage: show <file> [file...]" >&2
  exit 1
fi

for f in "$@"; do
  f="${f/#\~/$HOME}"
  [[ "$f" != /* ]] && f="$(pwd)/$f"
  if [ ! -e "$f" ]; then
    echo "show: not found: $f" >&2
    exit 1
  fi

  ext_lower="$(echo "${f##*.}" | tr '[:upper:]' '[:lower:]')"
  copy_note=""
  case "$ext_lower" in
    md|markdown|txt)
      open -a "CotEditor" "$f"
      ;;
    pdf)
      if command -v md5 >/dev/null 2>&1; then
        src_hash=$(printf '%s' "$f" | md5 | head -c 12)
      else
        src_hash=$(printf '%s' "$f" | md5sum | head -c 12)
      fi
      copy_dir="$SHOW_COPY_DIR/$src_hash"
      mkdir -p "$copy_dir"
      copy_path="$copy_dir/$(basename "$f")"
      cp -f "$f" "$copy_path"
      chmod 444 "$copy_path"
      open "$copy_path"
      copy_note=" (copy: $copy_path)"
      ;;
    *)
      open "$f"
      ;;
  esac

  echo "opened: $f$copy_note"
done

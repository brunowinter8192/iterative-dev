#!/usr/bin/env bash
# gcommit: stage all (tracked mods + untracked, minus skip-list) + commit, worktree-correct
# Source: iterative-dev/bin/gcommit (install/symlink to ~/.local/bin is the orchestrator's concern)
# Usage: gcommit "<message>" [repo_path]
# repo_path: absolute or relative path (relative resolves against caller's cwd; no worktree stripping). Defaults to caller's cwd. Refuses the plugin directory.

PLUGIN="${CLAUDE_PLUGIN_ROOT:-$HOME/.claude/plugins/cache/brunowinter-plugins/iterative-dev/1.0.0}"

if [ $# -lt 1 ]; then
  echo "Usage: gcommit \"<message>\" [repo_path]" >&2
  exit 1
fi

MESSAGE="$1"
REPO_INPUT="${2:-$(pwd)}"

REPO="$(cd "$REPO_INPUT" 2>/dev/null && pwd -P)" || {
  echo "gcommit: repo_path not found: $REPO_INPUT" >&2
  exit 1
}
PLUGIN_REAL="$(cd "$PLUGIN" 2>/dev/null && pwd -P)" || {
  echo "gcommit: plugin dir not found: $PLUGIN" >&2
  exit 1
}

case "$REPO/" in
  "$PLUGIN_REAL"/*)
    echo "gcommit: refusing to commit into the plugin directory ($REPO); pass the target repo path or run from inside it" >&2
    exit 1
    ;;
esac

cd "$PLUGIN" && python3 -m src.git.commit "$MESSAGE" "$REPO"

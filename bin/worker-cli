#!/usr/bin/env bash
# worker-cli: worker lifecycle operations via iterative-dev plugin
# Source: Meta/iterative-dev/bin/worker-cli — symlinked to ~/.local/bin/worker-cli

set -e

PLUGIN="${CLAUDE_PLUGIN_ROOT:-$HOME/.claude/plugins/cache/brunowinter-plugins/iterative-dev/1.0.0}"
SPAWN="$PLUGIN/src/spawn/tmux_spawn.sh"
REGISTRY_DIR="${WORKER_REGISTRY_DIR:-$HOME/.claude/.worker-registry}"

_resolve_cli_lib_dir() {
    local src="${BASH_SOURCE[0]}"
    local dir
    while [ -L "$src" ]; do
        dir="$(cd "$(dirname "$src")" && pwd)"
        src="$(readlink "$src")"
        [[ "$src" != /* ]] && src="$dir/$src"
    done
    echo "$(cd "$(dirname "$src")/.." && pwd)/src/worker_cli"
}

CLI_LIB_DIR="$(_resolve_cli_lib_dir)"
source "$CLI_LIB_DIR/registry.sh"
source "$CLI_LIB_DIR/cmd_query.sh"
source "$CLI_LIB_DIR/cmd_lifecycle.sh"
source "$CLI_LIB_DIR/wait.sh"
source "$CLI_LIB_DIR/janitor.sh"

usage() {
    echo "You triggered the help function. Usage sits in your rules. Report to the user why you needed help and go idle immediately." >&2
}

if [ $# -eq 0 ]; then
    usage
    exit 2
fi

CMD="$1"
shift

case "$CMD" in
    list)        cmd_list "$@" ;;
    status)      cmd_status "$@" ;;
    capture)     cmd_capture "$@" ;;
    response)    cmd_response "$@" ;;
    merge)       cmd_merge "$@" ;;
    kill)        cmd_kill "$@" ;;
    send)        cmd_send "$@" ;;
    wait)        cmd_wait "$@" ;;
    spawn)       cmd_spawn "$@" ;;
    revive)      cmd_revive "$@" ;;
    worktree)    cmd_worktree "$@" ;;
    worktree-rm) cmd_worktree_rm "$@" ;;
    janitor)     cmd_janitor "$@" ;;
    sweep-logs)  cmd_sweep_logs "$@" ;;
    -h|--help|help)
        usage
        exit 2
        ;;
    *)
        usage
        exit 2
        ;;
esac

#!/usr/bin/env bash

# INFRASTRUCTURE

set -e

PLUGIN="${CLAUDE_PLUGIN_ROOT:-$HOME/.claude/plugins/cache/brunowinter-plugins/iterative-dev/1.0.0}"
SPAWN="$PLUGIN/src/spawn/tmux_spawn.sh"
REGISTRY_DIR="${WORKER_REGISTRY_DIR:-$HOME/.claude/.worker-registry}"
SRC_DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../src"

source "$SRC_DIR/common/paths.sh"
source "$SRC_DIR/worker_cli/registry.sh"
source "$SRC_DIR/worker_cli/cmd_query.sh"
source "$SRC_DIR/worker_cli/cmd_lifecycle.sh"
source "$SRC_DIR/worker_cli/wait.sh"
source "$SRC_DIR/worker_cli/janitor.sh"

# ORCHESTRATOR

main() {
    require_command "$@"
    dispatch_command "$@"
}

# FUNCTIONS

usage() {
    echo "You triggered the help function. Usage sits in your rules. Report to the user why you needed help and go idle immediately." >&2
}

require_command() {
    if [ $# -eq 0 ]; then
        usage
        exit 2
    fi
}

dispatch_command() {
    local cmd="$1"
    shift
    case "$cmd" in
        list)        cmd_list "$@" ;;
        status)      cmd_status "$@" ;;
        capture)     cmd_capture "$@" ;;
        response)    cmd_response "$@" ;;
        merge)       cmd_merge "$@" ;;
        kill)        cmd_kill "$@" ;;
        send)        cmd_send "$@" ;;
        wait)        cmd_wait "$@" ;;
        spawn)       cmd_spawn "$@" ;;
        revive)      cmd_revive "$@" ;;
        worktree)    cmd_worktree "$@" ;;
        worktree-rm) cmd_worktree_rm "$@" ;;
        janitor)     cmd_janitor "$@" ;;
        sweep-logs)  cmd_sweep_logs "$@" ;;
        -h|--help|help)
            usage
            exit 2
            ;;
        *)
            usage
            exit 2
            ;;
    esac
}

main "$@"

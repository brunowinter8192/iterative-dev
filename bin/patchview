#!/usr/bin/env bash

# INFRASTRUCTURE

set -e

BIN_DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
REPO_ROOT="$BIN_DIR/.."

# ORCHESTRATOR

main() {
  local page
  page="$(render_page "$@")"
  "$BIN_DIR/show" "$page"
}

# FUNCTIONS

render_page() {
  python3 "$REPO_ROOT/src/patchview/__main__.py" "$@"
}

main "$@"
